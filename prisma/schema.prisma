generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                    String                 @id @default(cuid())
  name                  String
  slug                  String                 @unique
  isActive              Boolean                @default(true)
  address               String?
  city                  String?
  zipCode               String?
  email                 String?
  phone                 String?
  landTitle             String?
  srmContact            String?
  rib                   String?
  logoUrl               String?
  logoSize              String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  accountingPosts       AccountingPost[]
  actionLogs            ActionLog[]
  settings              AppSettings?
  backupAudits          BackupAudit[]
  backupSchedule        BackupSchedule?
  budgets               Budget[]
  buildings             Building[]
  claims                Claim[]
  claimComments         ClaimComment[]
  contributionGroups    ContributionGroup[]
  contributionPeriods   ContributionPeriod[]
  digitalVaultDocuments DigitalVaultDocument[]
  fiscalYears           FiscalYear[]
  importJobs            ImportJob[]
  incidents             Incident[]
  internalBanks         InternalBank[]
  meetings              Meeting[]
  monthlyDues           MonthlyDue[]
  notifications         Notification[]
  otherReceipts         OtherReceipt[]
  owners                Owner[]
  ownerships            Ownership[]
  payments              Payment[]
  receipts              Receipt[]
  suppliers             Supplier[]
  supplierSectors       SupplierSector[]
  units                 Unit[]
  userOrganizations     UserOrganization[]
}

model Owner {
  id             String       @id @default(uuid())
  organizationId String
  cin            String?
  firstName      String?
  name           String
  email          String?
  phone          String?
  notes          String?
  createdAt      DateTime     @default(now())
  userId         String?      @unique
  claims         Claim[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])
  ownerships     Ownership[]
  receipts       Receipt[]

  @@unique([organizationId, cin])
  @@index([organizationId])
  @@index([userId])
}

model Building {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  address        String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receipts       Receipt[]
  units          Unit[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Unit {
  id                  String                  @id @default(uuid())
  organizationId      String
  lotNumber           String?
  reference           String
  type                UnitType
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  buildingId          String?
  floor               Int?
  surface             Decimal?                @db.Decimal(10, 2)
  overrideStart       Boolean                 @default(false)
  startYear           Int?
  startMonth          Int?
  parentUnitId        String?
  claims              Claim[]
  groupUnits          ContributionGroupUnit[]
  contributionPeriods ContributionPeriod[]
  dues                MonthlyDue[]
  ownerships          Ownership[]
  receipts            Receipt[]
  building            Building?               @relation(fields: [buildingId], references: [id])
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentUnit          Unit?                   @relation("UnitParent", fields: [parentUnitId], references: [id])
  children            Unit[]                  @relation("UnitParent")

  @@unique([organizationId, lotNumber])
  @@index([buildingId])
  @@index([organizationId])
  @@index([parentUnitId])
  @@index([lotNumber])
}

model ContributionGroup {
  id             String                  @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  defaultAmount  Decimal?                @db.Decimal(10, 2)
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  units          ContributionGroupUnit[]
  periods        ContributionPeriod[]
  frequency      ContributionFrequency   @default(MONTHLY)

  @@index([organizationId])
}

model ContributionGroupUnit {
  id      String            @id @default(cuid())
  groupId String
  unitId  String
  group   ContributionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  unit    Unit              @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([groupId, unitId])
  @@index([groupId])
  @@index([unitId])
}

model ContributionPeriod {
  id               String             @id @default(uuid())
  organizationId   String
  contributionType ContributionType
  groupId          String?
  unitId           String?
  startPeriod      DateTime
  endPeriod        DateTime?
  amount           Decimal            @db.Decimal(10, 2)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  group            ContributionGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit             Unit?              @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([contributionType])
  @@index([groupId])
  @@index([unitId])
  @@index([startPeriod])
}

model Ownership {
  id             String       @id @default(uuid())
  organizationId String
  ownerId        String
  unitId         String
  startDate      DateTime     @default(now())
  endDate        DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          Owner        @relation(fields: [ownerId], references: [id])
  unit           Unit         @relation(fields: [unitId], references: [id])

  @@index([organizationId])
  @@index([ownerId])
  @@index([unitId])
}

model MonthlyDue {
  id                 String              @id @default(uuid())
  organizationId     String
  unitId             String
  period             DateTime
  amountDue          Decimal             @db.Decimal(10, 2)
  paidAmount         Decimal             @default(0) @db.Decimal(10, 2)
  status             DueStatus           @default(UNPAID)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  unit               Unit                @relation(fields: [unitId], references: [id])
  receiptAllocations ReceiptAllocation[]

  @@unique([organizationId, unitId, period])
  @@index([organizationId])
  @@index([unitId, organizationId, period])
  @@index([period])
  @@index([status])
}

model Payment {
  id               String          @id @default(uuid())
  organizationId   String
  paymentNumber    Int             @default(autoincrement())
  supplierId       String
  accountingPostId String?
  date             DateTime        @default(now())
  method           PaymentMethod
  amount           Decimal         @db.Decimal(10, 2)
  note             String?
  attachments      Json            @default("[]")
  bankName         String?
  bankRef          String?
  createdAt        DateTime        @default(now())
  bankId           String?
  accountingPost   AccountingPost? @relation(fields: [accountingPostId], references: [id])
  bank             InternalBank?   @relation(fields: [bankId], references: [id])
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier         Supplier        @relation(fields: [supplierId], references: [id])

  @@unique([organizationId, paymentNumber])
  @@index([organizationId])
  @@index([supplierId])
  @@index([accountingPostId])
  @@index([date])
  @@index([paymentNumber])
}

model Receipt {
  id                String              @id @default(uuid())
  organizationId    String
  receiptNumber     Int
  type              ReceiptType         @default(CONTRIBUTION)
  buildingId        String
  ownerId           String
  unitId            String?
  date              DateTime            @default(now())
  method            PaymentMethod
  amount            Decimal             @db.Decimal(10, 2)
  note              String?
  bankName          String?
  bankRef           String?
  unallocatedAmount Int                 @default(0)
  createdAt         DateTime            @default(now())
  bankId            String?
  bank              InternalBank?       @relation(fields: [bankId], references: [id])
  building          Building            @relation(fields: [buildingId], references: [id])
  organization      Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner             Owner               @relation(fields: [ownerId], references: [id])
  unit              Unit?               @relation(fields: [unitId], references: [id])
  allocations       ReceiptAllocation[]

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([buildingId])
  @@index([ownerId])
  @@index([unitId])
  @@index([unitId, type, date])
  @@index([date])
  @@index([receiptNumber])
  @@index([type, date, receiptNumber])
  @@index([buildingId, type, date])
  @@index([ownerId, type, date])
  @@index([method, type, date])
  @@index([organizationId, type, date])
}

model ReceiptAllocation {
  id        String     @id @default(uuid())
  receiptId String
  dueId     String
  amount    Decimal    @db.Decimal(10, 2)
  due       MonthlyDue @relation(fields: [dueId], references: [id])
  receipt   Receipt    @relation(fields: [receiptId], references: [id])

  @@index([receiptId])
  @@index([dueId])
}

model User {
  id            String             @id @default(cuid())
  name          String?
  email         String             @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          UserRole           @default(OPERATOR)
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  accounts      Account[]
  actionLogs    ActionLog[]
  claimComments ClaimComment[]
  notifications Notification[]
  owner         Owner?
  sessions      Session[]
  organizations UserOrganization[]
}

model UserOrganization {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           UserRole     @default(OPERATOR)
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model AppSettings {
  id                 String           @id @default(uuid())
  organizationId     String           @unique
  brandName          String           @default("Syndicly")
  brandColor         String           @default("#4f46e5")
  startYear          Int              @default(2026)
  startMonth         Int              @default(1)
  receiptStartNumber Int              @default(1)
  receiptUsePrefix   Boolean          @default(false)
  receiptPrefix      String?
  paymentStartNumber Int              @default(1)
  paymentUsePrefix   Boolean          @default(false)
  paymentPrefix      String?
  openingCashBalance Decimal          @default(0) @db.Decimal(12, 2)
  openingBankBalance Decimal          @default(0) @db.Decimal(12, 2)
  contributionType   ContributionType @default(GLOBAL_FIXED)
  globalFixedAmount  Decimal?         @db.Decimal(10, 2)
  frequency          ContributionFrequency @default(MONTHLY)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model FiscalYear {
  id             String       @id @default(uuid())
  organizationId String
  year           Int
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, year])
  @@index([organizationId])
  @@index([year])
}

model InternalBank {
  id                 String         @id @default(cuid())
  organizationId     String
  name               String
  isActive           Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  openingBalance     Decimal        @default(0) @db.Decimal(12, 2)
  accountNumber      String?
  agency             String?
  city               String?
  openingBalanceDate DateTime?
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  otherReceipts      OtherReceipt[]
  payments           Payment[]
  receipts           Receipt[]

  @@index([organizationId])
}

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  sector         String?
  contactName    String?
  phone          String?
  email          String?
  address        String?
  note           String?
  photoUrl       String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  payments       Payment[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model SupplierSector {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model AccountingPost {
  id             String       @id @default(cuid())
  organizationId String
  code           String
  name           String
  postType       PostType
  note           String?
  isActive       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  budgets        Budget[]
  payments       Payment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([postType])
}

model Budget {
  id               String         @id @default(cuid())
  organizationId   String
  accountingPostId String
  year             Int
  amount           Decimal        @db.Decimal(10, 2)
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  accountingPost   AccountingPost @relation(fields: [accountingPostId], references: [id])
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, accountingPostId, year])
  @@index([organizationId])
  @@index([accountingPostId])
  @@index([year])
}

model OtherReceipt {
  id             String        @id @default(uuid())
  organizationId String
  receiptNumber  Int
  type           ReceiptType
  description    String
  date           DateTime      @default(now())
  method         PaymentMethod
  amount         Decimal       @db.Decimal(10, 2)
  bankName       String?
  bankRef        String?
  note           String?
  createdAt      DateTime      @default(now())
  bankId         String?
  bank           InternalBank? @relation(fields: [bankId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, receiptNumber])
  @@index([organizationId])
  @@index([date])
  @@index([receiptNumber])
}

model ImportJob {
  id             String       @id @default(uuid())
  organizationId String
  type           String
  totalRows      Int
  processed      Int          @default(0)
  status         String       @default("running")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model DigitalVaultDocument {
  id                String       @id @default(uuid())
  organizationId    String
  name              String
  category          String
  fileName          String
  fileUrl           String
  mimeType          String
  sizeBytes         Int
  tags              String[]     @default([])
  isVisibleToOwners Boolean      @default(false)
  documentDate      DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([category])
  @@index([isVisibleToOwners])
  @@index([documentDate])
}

model Claim {
  id             String         @id @default(uuid())
  organizationId String
  ownerId        String
  unitId         String?
  title          String
  description    String
  category       String         @default("Général")
  status         ClaimStatus    @default(OPEN)
  priority       ClaimPriority  @default(NORMAL)
  photos         String[]       @default([])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner          Owner          @relation(fields: [ownerId], references: [id])
  unit           Unit?          @relation(fields: [unitId], references: [id])
  comments       ClaimComment[]
  notifications  Notification[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([unitId])
}

model ClaimComment {
  id             String       @id @default(uuid())
  claimId        String
  organizationId String
  userId         String
  message        String
  createdAt      DateTime     @default(now())
  claim          Claim        @relation(fields: [claimId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([claimId, createdAt])
  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
}

model Notification {
  id             String       @id @default(uuid())
  userId         String
  organizationId String
  claimId        String?
  type           String
  title          String
  message        String?
  link           String?
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())
  readAt         DateTime?
  claim          Claim?       @relation(fields: [claimId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, organizationId, isRead, createdAt])
  @@index([organizationId, createdAt])
  @@index([claimId])
}

model Incident {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  description    String
  location       String?
  status         String       @default("OPEN")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Meeting {
  id                 String              @id @default(uuid())
  organizationId     String
  title              String
  date               DateTime
  type               MeetingType         @default(ORDINARY)
  status             MeetingStatus       @default(SCHEDULED)
  description        String?
  location           String?
  convocationSentAt  DateTime?
  minutesGeneratedAt DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents          MeetingDocument[]
  resolutions        MeetingResolution[]

  @@index([organizationId])
}

model MeetingResolution {
  id           String                  @id @default(uuid())
  meetingId    String
  title        String
  description  String?
  voteRule     MeetingVoteRule
  status       MeetingResolutionStatus @default(PENDING)
  votesFor     Int                     @default(0)
  votesAgainst Int                     @default(0)
  abstentions  Int                     @default(0)
  orderIndex   Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  meeting      Meeting                 @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, orderIndex])
}

model MeetingDocument {
  id              String                    @id @default(uuid())
  meetingId       String
  type            MeetingDocumentType
  sourceType      MeetingDocumentSourceType @default(UPLOAD)
  title           String
  fileName        String?
  fileUrl         String?
  mimeType        String?
  sizeBytes       Int                       @default(0)
  vaultDocumentId String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  meeting         Meeting                   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId, type])
  @@index([vaultDocumentId])
}

model PageVisibilitySetting {
  id         String   @id @default(cuid())
  href       String   @unique
  title      String
  section    String
  icon       String
  isEnabled  Boolean  @default(true)
  superAdmin Boolean  @default(true)
  admin      Boolean  @default(true)
  manager    Boolean  @default(true)
  operator   Boolean  @default(true)
  viewer     Boolean  @default(true)
  owner      Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([section])
  @@index([isEnabled])
}

model SystemSettings {
  id                    String    @id @default(cuid())
  prismaLogging         Boolean   @default(true)
  updatedAt             DateTime  @updatedAt
  lastBackupHeartbeatAt DateTime?
}

model BackupSchedule {
  id             String       @id @default(cuid())
  organizationId String       @unique
  frequency      Int          @default(1440)
  isActive       Boolean      @default(true)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  retentionCount Int          @default(10)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([isActive, nextRunAt])
}

model BackupAudit {
  id             String       @id @default(cuid())
  organizationId String
  fileName       String
  status         String
  errorMsg       String?
  sizeBytes      Int          @default(0)
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?
  deletionType   String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
}

model ActionLog {
  id             String        @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  details        String?
  entityType     String?
  entityId       String?
  createdAt      DateTime      @default(now())
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  VIEWER
  OPERATOR
  OWNER
}

enum UnitType {
  APARTMENT
  GARAGE
  COMMERCIAL
}

enum DueStatus {
  UNPAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CASH
  TRANSFER
  CHECK
  DEBIT
  INTERNAL_TRANSFER
  BANK_DEPOSIT
}

enum ReceiptType {
  CONTRIBUTION
  RENT
  TRANSFER
  PAST_CONTRIBUTION
  OTHER
}

enum ContributionType {
  GLOBAL_FIXED
  GROUP_FIXED
  SURFACE
}

enum PostType {
  CHARGE
  PRODUCT
}

enum ClaimStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum ClaimPriority {
  LOW
  NORMAL
  HIGH
}

enum MeetingType {
  ORDINARY
  EXTRAORDINARY
}

enum MeetingStatus {
  SCHEDULED
  CONVOCATIONS_SENT
  MINUTES_READY
  COMPLETED
}

enum MeetingVoteRule {
  SIMPLE
  ABSOLUTE
  DOUBLE
  UNANIMOUS
}

enum MeetingResolutionStatus {
  PENDING
  ADOPTED
  REJECTED
}

enum MeetingDocumentType {
  ATTENDANCE_SHEET
  MINUTES
  OTHER
}

enum MeetingDocumentSourceType {
  UPLOAD
  VAULT
}
enum ContributionFrequency {
  MONTHLY
  ANNUAL
}
